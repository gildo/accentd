[Unit]
Description=Accent character daemon (press-and-hold popup)
After=default.target

[Service]
Type=simple
ExecStart=/usr/bin/accentd
Restart=on-failure
RestartSec=3
RuntimeDirectory=accentd
# The daemon runs in the user session and only needs /dev/input and /dev/uinput.
# Namespace-based hardening (ProtectHome, ProtectSystem, PrivateTmp) is omitted
# because Ubuntu restricts unprivileged user namespaces by default.
NoNewPrivileges=yes

[Install]
WantedBy=default.target
